# Normalize every text file to LF in the repository and in working trees, so
# shell scripts, the Makefile and the RTL behave the same on every host.
* text=auto eol=lf
*.png binary

*.sv linguist-language=SystemVerilog
*.svh linguist-language=SystemVerilog
*.vhd linguist-language=VHDL
*.vhdl linguist-language=VHDL
SYNTH_REPORT.md linguist-generated=true
